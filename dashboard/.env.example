# Dashboard env — Vite exposes only VITE_* to the browser.
# Any Orcta service (orctago, pos, dashboard) is one Orcta Pay consumer:
# plug its own product key here. Keys are provisioned in Vault at
# secret/orcta/orcta-pay/keys/{product} and rendered to .env as ORCTA_PAY_API_KEY.

VITE_ORCTA_PAY_URL=http://localhost:8080
VITE_ORCTA_PAY_API_KEY=pay_test_orctago_example

# Optional: override per-product when testing multiple products.
# The settings modal also lets you paste any product key at runtime
# (stored in localStorage as orcta_pay_api_key).

# VITE_ORCTA_PAY_PRODUCT=orctago
