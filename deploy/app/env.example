ORCTA_ENV=production
HTTP_PORT=8080
DATABASE_URL=postgres://orcta_pay:CHANGE_ME@orcta-pay-postgres:5432/orcta_pay?sslmode=disable
MIGRATION_DATABASE_URL=postgres://orcta_pay:CHANGE_ME@orcta-pay-postgres:5432/orcta_pay?sslmode=disable&lock_timeout=3s&statement_timeout=30s
VALKEY_ADDR=orcta-pay-valkey:6379
AUTH_TOKEN_SECRET=CHANGE_ME_at_least_32_chars
PAYMENTS_PRIMARY=paystack
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_BASE_URL=https://payproxyapi.hubtel.com
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
MOOLRE_API_KEY=
MOOLRE_BASE_URL=https://api.moolre.com
DEPLOY_SHA=latest
