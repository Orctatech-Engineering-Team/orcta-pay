POSTGRES_USER=orcta_pay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=orcta_pay

# --- Backups (deploy/data/BACKUP.md) ---
# Nightly pg_dump + WAL archive. Without S3, dumps stay on postgres_backups volume.
# With S3/Tigris, set the bucket + credentials and dumps are synced off-host.
# BACKUP_S3_BUCKET=orcta-pay-backups
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_ENDPOINT=https://fly.storage.tigris.dev
# WALG_S3_PREFIX=s3://orcta-pay-backups/orcta-pay/wal
# BACKUP_ENCRYPTION_KEY=  # passphrase for openssl aes-256-cbc at rest; use KMS/age in prod
# BACKUP_RETENTION_DAYS=7
# BACKUP_RETENTION_WEEKS=4
# BACKUP_RUN_ON_START=0   # set 1 to run a backup immediately on sidecar start (smoke test)
# ORCTA_ENV=production    # guard.sh refuses `down -v` when production/staging/prod
