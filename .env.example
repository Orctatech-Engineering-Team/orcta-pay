# Copy to .env for local development. .env is gitignored.
ORCTA_ENV=development

# --- HTTP ---
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_HANDLER_TIMEOUT=15s
WORKER_JOB_TIMEOUT=5m

# --- Postgres ---
DATABASE_URL=postgres://orcta:orcta@localhost:5432/orcta_pay?sslmode=disable
DATABASE_MAX_CONNS=20
POSTGRES_PORT=5432
MIGRATION_DATABASE_URL=postgres://orcta:orcta@localhost:5432/orcta_pay?sslmode=disable&lock_timeout=3s&statement_timeout=30s

# --- Valkey ---
VALKEY_ADDR=localhost:6379
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# --- Rate limiting ---
# Enable fixed-window rate limiting on POST /v1/charges and POST /v1/payouts.
# Uses Valkey INCR+EXPIRE with in-memory fallback when Valkey unavailable.
RATE_LIMIT_ENABLED=true
# Per-IP limit per minute for POST /v1/charges and POST /v1/payouts (default 60).
RATE_LIMIT_RPS=60
# Per-API-key limit per minute (default 300) and webhook limit per minute (default 600).
RATE_LIMIT_API_KEY_PER_MINUTE=300
RATE_LIMIT_WEBHOOK_PER_MINUTE=600

# --- Auth ---
AUTH_TOKEN_SECRET=CHANGE_ME_local_development_secret_at_least_32_chars
AUTH_API_KEY=
# Operator dashboard — POST /auth/login checks this (AuthGate). Use any dev value; production requires strong secret.
ORCTA_PAY_API_KEY=local-dev-operator-key-12345
# CORS for local dev when dashboard (:5173) calls API (:8080) with credentials. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Observability ---
LOG_LEVEL=info
OTEL_SERVICE_NAME=orcta-pay
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=1.0

# --- Payments ---
PAYMENTS_PRIMARY=hubtel
PAYMENT_PENDING_TIMEOUT=5m
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_BASE_URL=https://payproxyapi.hubtel.com
HUBTEL_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=
# Moolre 2.0 — amounts are decimal GHS strings on the wire ("18.00"), derived from pesewas.
# Live https://api.moolre.com, sandbox https://sandbox.moolre.com.
# Collections: POST /open/transact/payment with X-API-USER + X-API-PUBKEY, field externalref.
# Transfers: POST /open/transact/transfer with X-API-USER + X-API-KEY, field externalref.
# Webhooks have no published HMAC; dedup via webhook_inbox is source of truth.
MOOLRE_API_USER=
MOOLRE_API_KEY=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_BASE_URL=https://api.moolre.com
MOOLRE_WEBHOOK_SECRET=
PAYMENTS_CALLBACK_BASE_URL=
